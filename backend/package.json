{
  "name": "lcc-server",
  "version": "6.0.0",
  "description": "REST API for the London Chess Club website, built with Node and Express",
  "author": "Michal Wiraszka",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwiraszka/lcc-backend.git"
  },
  "private": true,
  "main": "src/server.ts",
  "scripts": {
    "start": "npx tsx watch --env-file=.dev.env src/server.ts",
    "start:dev-offline": "npx tsx watch --env-file=.dev-offline.env src/server.ts",
    "start:prod": "npx tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**' 'api/**'",
    "format": "prettier --write 'src/**/*.ts' 'api/**/*.ts'",
    "backup:all": "npx tsx scripts/backup-mongodb.ts",
    "backup:list": "npx tsx scripts/backup-mongodb.ts list",
    "backup:restore": "npx tsx --env-file=.dev.env scripts/restore-mongodb.ts",
    "backup:setup": "bash scripts/setup-backup-schedule.sh"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1060.0",
    "@aws-sdk/client-s3": "3.1060.0",
    "@aws-sdk/s3-request-presigner": "3.1060.0",
    "@sentry/node": "10.56.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "mongodb": "7.2.0",
    "mongoose": "9.6.3",
    "multer": "2.1.1",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.1.0",
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.8.3",
    "prettier-eslint": "16.4.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vitest": "4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "fast-xml-builder@<1.1.7": ">=1.1.7",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2"
    }
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
