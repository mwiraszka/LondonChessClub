{
  "name": "lcc-frontend",
  "version": "5.13.6",
  "description": "Frontend for the London Chess Club website, built with Angular",
  "author": "Michal Wiraszka",
  "repository": {
    "type": "git",
    "url": "https://github.com/mwiraszka/london-chess-club.git"
  },
  "private": false,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    "start:no-hmr": "ng serve -o --no-hmr",
    "start:prod": "ng serve -o --configuration production",
    "build:dev": "ng build",
    "build:preview": "ng build --configuration preview",
    "build:prod": "ng build --configuration production",
    "build:stats": "ng build --stats-json && webpack-bundle-analyzer dist/stats.json",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --watch --coverage",
    "format": "prettier --write .",
    "lint": "eslint 'src/**'"
  },
  "dependencies": {
    "@angular/animations": "21.2.17",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.17",
    "@angular/compiler": "21.2.17",
    "@angular/core": "21.2.17",
    "@angular/forms": "21.2.17",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.17",
    "@angular/platform-browser-dynamic": "21.2.17",
    "@angular/router": "21.2.17",
    "@googlemaps/js-api-loader": "2.1.1",
    "@ngneat/until-destroy": "10.0.0",
    "@ngrx/effects": "21.1.1",
    "@ngrx/entity": "21.1.1",
    "@ngrx/operators": "21.1.1",
    "@ngrx/router-store": "21.1.1",
    "@ngrx/store": "21.1.1",
    "@ngrx/store-devtools": "21.1.1",
    "@sentry/angular": "10.58.0",
    "@webcomponents/webcomponentsjs": "2.8.0",
    "chart.js": "4.5.1",
    "lichess-pgn-viewer": "2.4.5",
    "lodash": "4.18.1",
    "marked": "18.0.5",
    "moment-timezone": "0.6.2",
    "ng2-pdf-viewer": "10.4.0",
    "ngrx-store-localstorage": "20.1.0",
    "ngx-markdown": "21.3.0",
    "remove-markdown": "0.6.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/core": "21.2.16",
    "@angular/build": "21.2.16",
    "@angular/cli": "21.2.16",
    "@angular/compiler-cli": "21.2.17",
    "@eslint/js": "10.0.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/google.maps": "3.65.1",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.24",
    "@types/node": "25.9.3",
    "@types/remove-markdown": "0.3.4",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "autoprefixer": "10.5.0",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.6.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-preset-angular": "16.1.5",
    "postcss": "8.5.15",
    "prettier": "3.8.4",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "yargs": "18.0.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@angular/build>typescript": "6"
      }
    },
    "allowedDeprecatedVersions": {
      "chessground": "9.2.1",
      "prebuild-install": "7.1.3",
      "whatwg-encoding": "3.1.1"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "canvas",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "unrs-resolver"
    ],
    "overrides": {
      "lodash-es@>=4.0.0 <=4.17.23": ">=4.18.0",
      "dompurify@<3.4.0": ">=3.4.0",
      "fast-uri@<3.1.2": ">=3.1.2",
      "hono@<4.12.25": ">=4.12.25",
      "ip-address@<10.1.1": ">=10.1.1",
      "mermaid@<11.15.0": ">=11.15.0",
      "uuid@<14.0.0": ">=14.0.0",
      "@babel/core@<7.29.6": ">=7.29.6",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "js-yaml@<4.2.0": ">=4.2.0",
      "vite@>=7.0.0 <=7.3.4": ">=7.3.5",
      "ws@<8.21.0": ">=8.21.0"
    }
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
